#!/bin/sh
# Blocks a push that introduces a bare TODO/FIXME -- one not tagged with a ticket reference
# like `TODO(WXL-123): ...`. A ticketed TODO passes through fine; this only catches the ones
# that would otherwise leave the machine with no tracking ticket at all.
#
# Scope: only lines ADDED by the commits actually being pushed (not the whole repo history),
# so this doesn't retroactively block on anything that predates the convention.
#
# Intentional exception: `git push --no-verify`.

zero="0000000000000000000000000000000000000000"
empty_tree="4b825dc642cb6eb9a060e54bf8d69288fbee4904"
bad=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue  # deleting a ref, nothing to check

    if [ "$remote_sha" = "$zero" ]; then
        range="$empty_tree..$local_sha"  # brand new ref: everything reachable from it is "new"
    else
        range="$remote_sha..$local_sha"
    fi

    # ':!.githooks/pre-push' excludes this file's own diff from the scan -- it necessarily
    # contains the literal words TODO/FIXME as part of the detection regex below, which would
    # otherwise self-match the very first time this file is ever added or edited.
    matches=$(git diff "$range" -- . ':!.githooks/pre-push' 2>/dev/null | grep -nE '^\+[^+].*\b(TODO|FIXME)\b' | grep -vE '\bTODO\(WXL-[0-9]+\)')
    if [ -n "$matches" ]; then
        echo "pre-push: found a TODO/FIXME with no ticket reference on $local_ref:"
        echo "$matches"
        bad=1
    fi
done

if [ "$bad" -ne 0 ]; then
    echo ""
    echo "Blocked. Use \`TODO(WXL-123): ...\` to reference a ticket, resolve it, or push with"
    echo "--no-verify if this one is genuinely intentional."
    exit 1
fi

exit 0
